# Normalise line endings in the repository (LF). Shell scripts must stay LF on every OS so they
# run inside Linux containers even when the repository is checked out on Windows.
* text=auto eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
*.mp4 binary
*.webm binary
