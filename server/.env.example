# Copy this file to server/.env and adjust. server/.env is git-ignored — never commit it.
# Every value below works as-is for local development (http://localhost:5173).

# ---- Server ----
NODE_ENV=development
PORT=4000
# The address people open in the browser. Used for CORS and for links in emails
# (invites, verification, password reset, email change).
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Dev uses SQLite (file is created next to schema.prisma).
# For production PostgreSQL, change `provider` in prisma/schema.prisma and set e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/sageavatar
DATABASE_URL=file:./dev.db

# ---- Auth ----
# Signs login sessions. REQUIRED, at least 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# ---- Storage ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# ---- Sign-up ----
# Self sign-up (Employee accounts) only accepts these email domains (comma-separated).
SIGNUP_EMAIL_DOMAINS=sageitinc.com

# ---- Email (SMTP) ----
# Empty SMTP_HOST in development = emails are saved to storage/outbox, NOT delivered.
# Office 365 example: host smtp.office365.com, port 587, SMTP AUTH must be enabled on the mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SageVatar <no-reply@sageitinc.com>"

# ---- AI Avatar Finder & Generator (OpenAI) ----
# Server-side only — never put this key in the client. Empty = AI generation off and search uses
# keywords only; the avatar library keeps working either way.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium        # low | medium | high | auto (cost rises with quality)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMPLOYEE_GENERATION=true        # false = only Creators can generate
# AI_DAILY_IMAGE_LIMIT=24            # images per user per day

# ---- Seed accounts (development only) ----
# Created by `npm run db:migrate` / `npm run db:seed`. Local demo logins — change them if you like.
# The seed refuses to run when NODE_ENV=production.
SEED_CREATOR_EMAIL=creator@sageavatar.local
SEED_CREATOR_PASSWORD=Creator@12345
SEED_EMPLOYEE_EMAIL=employee@sageavatar.local
SEED_EMPLOYEE_PASSWORD=Employee@12345

# ---- Auth hardening (defaults shown) ----
SESSION_MAX_AGE_HOURS=8
INVITE_TTL_HOURS=72
LOGIN_RATE_LIMIT_MAX=20
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
REMEMBER_ME_DAYS=30
VERIFY_TTL_HOURS=24
RESET_TTL_MINUTES=30
# Session cookie Secure flag. Empty = on only when NODE_ENV=production.
# Set false only for plain-HTTP deployments on a private network.
COOKIE_SECURE=
