# Docker runtime data (database + uploads)
docker-data/

# Self-signed TLS for LAN HTTPS (generated locally, never committed)
docker/certs/

# Prisma shadow / scratch databases anywhere
*.db
*.db-journal

# Private keys and certificates
*.pem
*.key
*.crt

# Personal AI-assistant / tool settings
.claude/
