# Optional: background image for the login and sign-up pages (path under client/public).
# Only use images SageIT owns or has licensed.
# Login / Sign Up background. Default: /backgrounds/city-hero.webp. .mp4/.webm plays as video.
# VITE_AUTH_BACKGROUND=/backgrounds/your-image.webp

# Expose the Vite dev server on your local network (http://<LAN-IP>:5173). Off by default.
# Note: other devices can only use the live camera over HTTPS (see README → Docker / HTTPS).
# DEV_HOST=true
